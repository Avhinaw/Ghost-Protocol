# Base Sepolia deployment
RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=0x4B58BEEA180668b0bc80f8B1B6390E08d21003a1

# Set this in Render's secret environment settings only. It must belong to
# an oracle authorized on the deployed contract. Never commit the private key.
# ORACLE_PRIVATE_KEY=

PORT=4000
CORS_ORIGIN=https://ghost-protocol-asf.pages.dev
ORACLE_SCAN_INTERVAL_MS=21600000
ORACLE_AUTO_TRIGGER=false

# Optional AI verifier URL. Leave unset unless a separately hosted verifier is configured.
# AI_VERIFIER_URL=
AI_ASSESSMENT_TTL_MS=900000
# Set a long random value in Render only if enabling the reviewer gate.
# REVIEWER_APPROVAL_TOKEN=
